      "css": ".ds-gnote{font-family:'Schibsted Grotesk',ui-sans-serif,system-ui,sans-serif;position:relative;display:grid;gap:10px;width:300px;background:#F7E27B;color:#2B2610;padding:26px 26px 22px;border-radius:2px;transform:rotate(-1.2deg);box-shadow:0 2px 3px rgba(0,0,0,.12),0 14px 30px rgba(0,0,0,.18)}.ds-gnote::before{content:'';position:absolute;top:-9px;left:50%;width:18px;height:18px;margin-left:-9px;border-radius:50%;background:#C23B32}.ds-gh{font:500 23px/1.25 'Source Serif 4',Georgia,serif;margin:0}.ds-gh em{display:block;font-style:italic}.ds-gnote input{border:0;border-bottom:2px solid #2B2610;background:rgba(255,255,255,.45);padding:10px;font-size:18px;border-radius:4px 4px 0 0;min-height:44px}.ds-gnote input:focus-visible{outline:2.5px solid #173A2D;outline-offset:2px}.ds-gnote button{border:0;background:#173A2D;color:#fff;border-radius:8px;padding:11px 14px;font-weight:600;min-height:44px;cursor:pointer}.ds-gnote button:hover{filter:brightness(1.12)}"
    }
  ],
  "narrative": {
    "northStar": "The Decide Wall",
    "overview": "Cash read the way a T-Sprint team decides. A flat forest-green shell holds the brand and the six stage tabs (Map, Sketch, Decide, Prototype, Test, Ask); below it sits a cool whiteboard-white wall where a plain serif verdict leads, a ruled figure strip follows, and charts carry an exact-figure margin. Coloured sticker dots are the single state language across every chart, list and label.\n\nAccuracy beats atmosphere. Every figure is exact, traceable (Show working) and labelled actual or forecast. Decoration earns its place only by meaning something: the dots are data, the gate scene is the one piece of set dressing, and it sits outside the dashboard.",
    "keyCharacteristics": [
      "Flat green shell, whiteboard wall, white paper panels with hairline borders.",
      "Sticker dots: solid = actual, ring = forecast, colour = state, count = urgency.",
      "Orange is the forecast colour in data.",
      "Serif only for the verdict voice; grotesk for everything else, modest sizes.",
      "Every number is a button that opens its working."
    ],
    "rules": [
      {
        "name": "The Sticker Rule",
        "body": "Dots are the only state language. Solid = actual, ring = forecast. Colour = state: green above the safety line, amber below it, coral below zero or most urgent, slate = keep an eye. On the watch list, 1–3 dots = urgency (3 coral, 2 amber, 1 slate); a forecast item shows rings in its severity colour.",
        "section": "colors"
      },
      {
        "name": "The Orange-Is-Forecast Rule",
        "body": "In data marks, orange means forecast and nothing else: ring dots, the dashed forecast line, outlined budget bars, the forecast wash, forecast text and rows. Outside the data, the build uses the same orange only as the interaction signal: focus ring, hover/highlight wash, current-tab dot, pressed Replay, slider accent, selected scenario border.",
        "section": "colors"
      },
      {
        "name": "The Non-Sticker Series Rule",
        "body": "Series that are not states (Sketch in/out columns, horizontal bars, actual spend) use forest `ser-in` and grey `ser-out`, never sticker colours. Non-operating money is an outlined grey bar. Magnitude grids use the `seq-1..4` ramp.",
        "section": "colors"
      },
      {
        "name": "The Exact Figure Rule",
        "body": "Figures are exact `en-IN` rupees with Indian grouping (₹1,92,490.53; paisa where shown, whole rupees where `dp=0`). The short lakh/crore form (₹1.92L, ₹1.24Cr) appears only on chart axes and direct labels. Negatives use a true minus (−) joined to ₹ by a word joiner (U+2060) so they never break across lines.",
        "section": "typography"
      },
      {
        "name": "The Columnar Numerals Rule",
        "body": "Tabular figures apply only where numbers stack in columns: tables, Show working steps, tooltip rows, slider readouts. Figure strips, verdicts and labels keep proportional figures.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** use the sticker code exactly: solid = actual, ring = forecast, green/amber/coral/slate = state, 1–3 dots = urgency.",
      "**Do** keep orange for forecast in data marks; use `ser-in`/`ser-out` for series and `seq-1..4` for magnitude.",
      "**Do** show exact `en-IN` figures with Indian grouping; keep lakh/crore short forms to chart axes and direct labels.",
      "**Do** make every figure a Show working button, label actual vs forecast, and give every chart a table view.",
      "**Do** use one y-axis per chart and direct labels instead of legends where they fit.",
      "**Do** use `minmax(0,1fr)` tracks and `min-width: 0` on new grids.",
      "**Do** respect `prefers-reduced-motion`; motion only traces or steps through data that is already exact."
    ],
    "donts": [
      "**Don't** use Poppins, serif capitals, or oversized zoomed-in titles; type stays at the modest sizes above.",
      "**Don't** use emoji icons; icons are inline stroked SVG.",
      "**Don't** add decoration that carries no meaning, or put any theme behind figures.",
      "**Don't** add a language switch.",
      "**Don't** invent metrics the workbook does not hold (ARR, MRR, pipeline).",
      "**Don't** add 3D; it was tried for the gate and skipped because it added no meaning.",
      "**Don't** use count-up number animations or animate a line in from nothing.",
      "**Don't** use sticker colours (green, amber, coral, slate, orange) for non-state series.",
      "**Don't** add a second y-axis.",
      "**Don't** apply tabular figures outside columnar contexts."
    ]
  }
}
