      "html": "<h2 class=\"ds-verdict\">Cash closed October at &#8377;1,92,491.<em>On the plan, it runs out in November 2026.</em></h2>",
      "css": ".ds-verdict{font:500 26px/1.28 'Source Serif 4',Georgia,serif;color:#173A2D;margin:0;max-width:30em}.ds-verdict em{display:block;font-style:italic;color:#C23B32}"
